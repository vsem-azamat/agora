# Build output
/dist/
# the web app's build; only .keep is tracked, so the embed compiles without a build
/internal/web/dist/*
!/internal/web/dist/.keep
/bin/
node_modules/

# Local environment
.env
.env.*

# Scratch and temporary files never belong in the repository
/tmp/
/scratch/
*.log
*.tmp

# OpenSpec change folders are not used; specs are edited in place
/openspec/changes/

# Editors and OS
.idea/
.vscode/
.DS_Store
